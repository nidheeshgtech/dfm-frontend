{
  "name": "arena-html-page",
  "version": "1.0.0",
  "private": true,
  "description": "ARENA landing pages (investor + company), static HTML/SCSS",
  "scripts": {
    "build": "sass scss/main.scss css/main.css --style=compressed --no-source-map",
    "watch": "sass --watch scss/main.scss css/main.css --style=compressed --no-source-map",
    "dev": "sass --watch scss/main.scss css/main.css --embed-sources"
  },
  "devDependencies": {
    "sass": "^1.80.0"
  }
}
