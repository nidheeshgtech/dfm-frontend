{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/", "destination": "/html-page/", "permanent": false },
    { "source": "/index.html", "destination": "/html-page/", "permanent": false },
    { "source": "/company", "destination": "/html-page/company.html", "permanent": false },
    { "source": "/html-page/growth-market.html", "destination": "/html-page/growth-companies.html", "permanent": true },
    { "source": "/html-page/private-market.html", "destination": "/html-page/private-companies.html", "permanent": true },
    { "source": "/html-page/closed-market.html", "destination": "/html-page/family-business.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/html-page/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/html-page/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/html-page/js/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
